{
  "name": "clash-fleet",
  "version": "0.1.0",
  "description": "Multi-device configuration, deployment and diagnostics toolchain for Clash Verge Rev / Mihomo",
  "type": "module",
  "bin": {
    "fleet": "./bin/fleet.js"
  },
  "scripts": {
    "setup:boa": "node ./scripts/setup-boa.js",
    "lint": "node ./scripts/lint.js",
    "build": "node ./bin/fleet.js build",
    "package": "node ./bin/fleet.js package",
    "test": "node --test test/**/*.test.js",
    "test:oracle": "FLEET_REQUIRE_LEGACY_ORACLE=1 node --test test/legacy-oracle-comparison.test.js"
  },
  "keywords": [
    "clash",
    "clash-verge-rev",
    "mihomo",
    "boa-engine"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "rollup": "^4.22.4",
    "yaml": "^2.9.1"
  }
}
